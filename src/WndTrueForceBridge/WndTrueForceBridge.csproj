<Project Sdk="Microsoft.NET.Sdk">

  <!-- GPL-2.0-only helper process. MUST NOT reference AcEvoFfbTuner.Core (or be
       referenced as an assembly by the closed app): the only shared source is
       the MIT protocol contract in ..\Shared. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Fixed RID so `dotnet restore` of the solution produces win-x64 assets
         for the self-contained publish chained from the app's Publish. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AssemblyName>WndTrueForceBridge</AssemblyName>
    <RootNamespace>WndTrueForceBridge</RootNamespace>
    <Product>WnDTech TrueForce Bridge</Product>
    <Company>WnDTech</Company>
    <Copyright>Copyright (C) 2026 WnDTech. GPL-2.0-only.</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Self-contained publish (chained from the app's Publish): trim to keep the
       helper small. No reflection or serializers are used. -->
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\TrueForceBridgeProtocol.cs" Link="Shared\TrueForceBridgeProtocol.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LICENSE" Link="WndTrueForceBridge-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
